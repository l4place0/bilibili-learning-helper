# ============================================================
# ASR / Whisper
# ============================================================
ASR_PROVIDER=whisper-cpp             # whisper-cpp | local | openai
ASR_PROFILE=balanced                 # fast | balanced | accurate
ASR_ENDPOINT=                        # e.g. http://gpu-server:8001 (for local)
ASR_API_KEY=                         # API key (for openai cloud)
ASR_MODEL=whisper-1                  # cloud model name
ASR_TIMEOUT_SECONDS=3600
WHISPER_CPP_EXECUTABLE=whisper-cli
# VIDEO_SUM_MODEL_DIR=/absolute/path/to/models
# WHISPER_CPP_MODEL=/absolute/path/to/ggml-small-q5_1.bin

# ============================================================
# Cookies (Bilibili VIP / login)
# ============================================================
# VIDEO_SUM_COOKIES_PATH=/absolute/path/to/cookies.txt

# ============================================================
# Frame Extraction
# ============================================================
SCENE_THRESHOLD=0.3                  # scene-change sensitivity (scene mode)
SCENE_OFFSETS=0,0.5,1,2              # burst candidates after a cut
FRAME_FORMAT=webp                    # webp | jpg | png
FRAME_QUALITY=85                     # 1-100
FRAME_WIDTH=1280                     # max pixel width
FRAME_WORKERS=4                      # concurrent timestamp frame extraction
MIN_GAP=5.0                          # min seconds between scene frames
MAX_SCENE_PER_SEG=2                  # max scene frames per segment
SEGMENTS=60                          # number of segments for scene analysis

# ============================================================
# Storage
# ============================================================
# VIDEO_SUM_CACHE_DIR=/absolute/path/to/cache
# VIDEO_SUM_LIBRARY_DIR=/absolute/path/to/video-notes

# ============================================================
# Capture defaults
# ============================================================
VIDEO_SUM_DEFAULT_LANGUAGE=zh
VIDEO_SUM_DEFAULT_FRAMES=10
VIDEO_SUM_DEFAULT_FRAME_MODE=hybrid
VIDEO_SUM_DEFAULT_CACHE_POLICY=reuse
VIDEO_SUM_FACT_CHECK=auto
VIDEO_SUM_FACT_CHECK_SOURCE_POLICY=primary-first
