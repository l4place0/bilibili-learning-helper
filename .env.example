# ============================================================
# Server
# ============================================================
HOST=127.0.0.1
PORT=8000
API_SECRET=your-strong-random-secret-here

# ============================================================
# LLM Provider
# ============================================================
LLM_PROVIDER=openai                  # openai | claude
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o          # vision-capable model; empty = fall back to OPENAI_MODEL

ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_BASE_URL=                  # optional custom endpoint
CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================================
# ASR / Whisper
# ============================================================
WHISPER_MODEL=medium                 # tiny | base | small | medium | large-v3
WHISPER_BACKEND=faster               # faster | openai
HF_ENDPOINT=                         # HuggingFace mirror, e.g. https://hf-mirror.com

ASR_PROVIDER=inprocess               # inprocess | local | openai
ASR_ENDPOINT=                        # e.g. http://gpu-server:8001 (for local)
ASR_API_KEY=                         # API key (for openai cloud)
ASR_MODEL=whisper-1                  # cloud model name

# ============================================================
# Cookies (Bilibili VIP / login)
# ============================================================
COOKIES_PATH=data/cookies.txt

# ============================================================
# Vision / Frame Extraction
# ============================================================
FRAME_MODE=interval                  # interval | scene
MAX_FRAMES=10
FRAME_INTERVAL=30                    # seconds between frames (interval mode)
SCENE_THRESHOLD=0.3                  # scene-change sensitivity (scene mode)
FRAME_FORMAT=webp                    # webp | jpg | png
FRAME_QUALITY=85                     # 1-100
FRAME_WIDTH=1280                     # max pixel width
MIN_GAP=5.0                          # min seconds between scene frames
MAX_SCENE_PER_SEG=2                  # max scene frames per segment
SEGMENTS=60                          # number of segments for scene analysis

# ============================================================
# GitHub Pages Publish
# ============================================================
GITHUB_REPO=your-username/your-repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_BRANCH=gh-pages
GITHUB_PAGES_URL=https://your-username.github.io/your-repo

# ============================================================
# Storage
# ============================================================
DATA_DIR=data
AUTO_CLEANUP_DAYS=7                  # auto-delete cache older than N days
